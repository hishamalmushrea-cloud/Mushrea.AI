root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
max_line_length = 140
trim_trailing_whitespace = true

[*.{kt,kts}]
ktlint_standard = enabled
ktlint_standard_no-wildcard-imports = disabled
ktlint_standard_max-line-length = disabled
ktlint_standard_filename = disabled
# ktlint 1.2.1 oscillates on this rule: spotlessApply wraps the rhs of a val and the
# next spotlessCheck unwraps it again (and vice versa), so apply and check never agree.
# Keep the rule off until the formatter converges; the code style stays hand-wrapped.
ktlint_standard_multiline-expression = disabled
ktlint_function_naming_ignore_when_annotated_with = Composable

[*.md]
trim_trailing_whitespace = false

[*.yml]
indent_size = 2
